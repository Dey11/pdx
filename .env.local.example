# Local development without Docker.
# Requires local PostgreSQL and Redis already running on the host.

NODE_ENV=development

# Web
PORT=3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-local-secret
AUTH_SECRET=replace-with-a-local-secret
AUTH_TRUST_HOST=true

# Auth providers
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Email/password reset
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM="NoteFormula <support@noteformula.com>"

# Local database
DATABASE_URL=postgresql://user:password@localhost:5432/noteformula_dev

# Local Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# Worker callback when running `bun run worker:dev` locally
BACKEND_URL=http://localhost:3000

# Shared secret authenticating worker -> web callbacks (/api/generation/*).
# Must be identical for the web app and the worker in every environment.
WORKER_CALLBACK_SECRET=replace-with-a-local-random-secret

# BYOK encryption. Generate a local value with `openssl rand -base64 32`.
BYOK_ENCRYPTION_KEY=replace-with-exactly-32-random-bytes-in-base64
AI_GENERATION_MAX_OUTPUT_TOKENS=8000

# Cloudflare R2
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
BUCKET_NAME=test

# Puppeteer/Chrome for local PDF generation
PUPPETEER_EXECUTABLE_PATH=

# Analytics
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
