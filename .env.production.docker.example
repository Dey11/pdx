# Production Docker/Coolify env.
# Paste this as one combined env list in Coolify, then replace all placeholder values.

NODE_ENV=production

# Public URL the Coolify proxy routes to the web service (also used as the app
# base URL). Coolify sets this from the app's compose domain; keep in sync with
# BETTER_AUTH_URL.
SERVICE_FQDN_WEB_3000=https://pdx.sdey.me:3000

# External managed Postgres (Neon). Postgres is not part of the compose stack.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/neondb?sslmode=require

# Compose-managed Redis
REDIS_PASSWORD=replace-with-a-strong-redis-password
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_TLS=false

# Public web/auth URL
BETTER_AUTH_URL=https://pdx.sdey.me
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_TRUST_HOST=true

# Optional auth providers. Leave both values for a provider blank to keep it
# disabled in Better Auth and hidden from the login page.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Optional email/password reset. Leave AUTH_RESEND_KEY blank to hide reset UI;
# email/password registration and sign-in remain enabled.
AUTH_RESEND_KEY=
AUTH_EMAIL_FROM="NoteFormula <support@noteformula.com>"

# Worker internal callback URL inside Docker Compose
BACKEND_URL=http://web:3000

# Shared secret authenticating worker -> web callbacks (/api/generation/*).
# Must be identical for the web and worker services (see src/lib/worker-auth.ts
# and worker/src/callback.ts). Required in production.
WORKER_CALLBACK_SECRET=replace-with-a-long-random-secret

# BYOK encryption. Web-only; generate with `openssl rand -base64 32`.
BYOK_ENCRYPTION_KEY=replace-with-exactly-32-random-bytes-in-base64
AI_GENERATION_MAX_OUTPUT_TOKENS=8192

# Cloudflare R2
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
BUCKET_NAME=prod

# Puppeteer/Chrome inside the worker image
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

# Analytics
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
